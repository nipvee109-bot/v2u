# V2U environment (Phase 72) — copy to .env.local and fill in. NEVER commit real values.
# Firebase web config (public client identifiers; access is enforced by firestore.rules).
# Leave empty to run V2U in guest mode (no accounts, /admin shows "not configured").
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# DEVELOPMENT ONLY: in-memory admin fixture for `npm run dev` (ignored by production builds).
# Pick the signed-in role with localStorage key v2u-dev-as (e.g. REVIEWER).
VITE_V2U_DEV_ADMIN=0

# Never put service-account keys, Admin SDK private keys or OAuth client secrets here.
