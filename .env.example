# V2U environment (Phase 72B) — copy to .env.local and fill in. NEVER commit real values.
# Supabase (Project Settings → API). Only the project URL and the PUBLIC anon/publishable key
# belong here; access is enforced by Row Level Security (supabase/migrations).
# Leave empty to run V2U in guest mode (no accounts, /admin shows "not configured").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# DEVELOPMENT ONLY: in-memory admin fixture for `npm run dev` (ignored by production builds).
# Pick the signed-in role with localStorage key v2u-dev-as (e.g. REVIEWER).
VITE_V2U_DEV_ADMIN=0

# NEVER put these in any VITE_* variable or commit them:
#   SUPABASE_SERVICE_ROLE_KEY / sb_secret_… keys, database passwords, Google OAuth client secret.
